# RoadGuard AI — Environment Configuration
# Copy this file to .env to configure optional cloud services

# Supabase PostgreSQL & Storage (Optional: leave blank for self-contained Demo Mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional external Computer Vision endpoint (e.g. YOLOv8 or Custom Flask/FastAPI service)
# Leave blank to use RoadGuard built-in Edge-CV Heuristic Engine
VITE_AI_MODEL_ENDPOINT=

# OpenStreetMap Tile Provider (Configurable per Leaflet terms)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
